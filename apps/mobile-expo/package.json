{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:go": "expo start --android",
    "ios": "expo run:ios",
    "ios:go": "expo start --ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "web": "expo start --web",
    "export:ios:production": "FIELDSOLO_RELEASE_EXPORT=true EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_IS_TESTFLIGHT=false EXPO_PUBLIC_ANALYTICS_DEBUG_RICH=false expo export --platform ios",
    "test": "jest --config ./jest.config.js",
    "test:watch": "jest --config ./jest.config.js --watch"
  },
  "dependencies": {
    "@expo-google-fonts/pt-serif": "^0.4.1",
    "@expo-google-fonts/ubuntu": "^0.4.1",
    "@expo/metro-runtime": "~56.0.19",
    "@fieldsolo/api-client": "*",
    "@fieldsolo/design-system": "^0.0.0",
    "@fieldsolo/shared-types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "^2.11.4",
    "expo": "~56.0.19",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.23",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
