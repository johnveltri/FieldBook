# Local development is configured automatically by `npm run local:setup`.
# The generated values belong in `.env.local`, which is ignored by Git.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ANALYTICS_PROVIDER=none
# Dev-only: skip PostHog and enable fullscreen job detail edit locally (__DEV__ + development).
EXPO_PUBLIC_JOB_DETAIL_FULLSCREEN_EDIT=true
EXPO_PUBLIC_ANALYTICS_DEBUG_RICH=false
EXPO_PUBLIC_IS_TESTFLIGHT=false
